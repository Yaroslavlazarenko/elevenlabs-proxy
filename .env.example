# ── Proxy authentication ────────────────────────────────────────────────
# Clients must send this value in the xi-api-key header to authenticate
# with the proxy (NOT a real ElevenLabs key).
PROXY_API_KEY=your-proxy-secret-key-here

# ── ElevenLabs API keys (pool) ─────────────────────────────────────────
# Option 1 (default): File with one key per line (mounted into container)
ELEVENLABS_API_KEYS_FILE=/app/keys.txt

# Option 2: Comma-separated list of keys (takes priority over file)
# ELEVENLABS_API_KEYS=sk-key1,sk-key2,sk-key3

# ── ElevenLabs upstream ────────────────────────────────────────────────
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000

# ── Retry / cooldown tuning ────────────────────────────────────────────
# Number of retry attempts for 500/503 errors
# RETRY_COUNT=3

# Delay between retries in milliseconds
# RETRY_DELAY_MS=1000

# Cooldown period for rate-limited keys (ms) — used when no Retry-After header
# KEY_COOLDOWN_MS=60000

# Upstream request timeout in seconds
# REQUEST_TIMEOUT_SECONDS=120
